---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getSiteConfig } from "../lib/config";
import { localizeSite, localeMeta, type Locale } from "../lib/i18n";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  locale: Locale;
}

const { locale } = Astro.props;
const site = localizeSite(getSiteConfig(), locale);
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.titleSuffix}` : site.titleSuffix;
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang} data-locale={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={site.brand.logoUrl} />
    <title>{pageTitle}</title>
    <script is:inline>
      const storedTheme = localStorage.getItem("release-radar-theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.dataset.theme = storedTheme || (prefersDark ? "dark" : "light");
    </script>
    <script is:inline define:vars={{ locale }}>
      localStorage.setItem("release-radar-locale", locale);
    </script>
  </head>
  <body>
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
