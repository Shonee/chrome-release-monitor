---
import { ArrowUpRight, Database, FileSearch, Image, Radio } from "lucide-astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSourcesConfig } from "../../lib/config";
import {
  getLocaleStaticPaths,
  getUi,
  localizeOfficialSource,
  requireLocale,
} from "../../lib/i18n";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const locale = requireLocale(Astro.params.lang);
const copy = getUi(locale).sources;
const sources = getSourcesConfig();
const sourceIcons = [Radio, FileSearch, Database, Image];
---

<BaseLayout locale={locale} title={copy.title} description={copy.description}>
  <section class="page-intro page-shell">
    <span class="eyebrow">{copy.eyebrow}</span>
    <h1>{copy.heading}</h1>
    <p>{copy.summary}</p>
  </section>
  <section class="page-shell source-list">
    {
      sources.officialSources.map((rawSource, index) => {
        const source = localizeOfficialSource(rawSource, locale);
        const Icon = sourceIcons[index % sourceIcons.length];
        const href =
          source.url || source.urlTemplate?.replace("{milestone}", "152");
        return (
          <article>
            <Icon size={20} />
            <div>
              <>
                <span>{source.type}</span>
                <h2>{source.name}</h2>
                <p>{source.description}</p>
              </>
            </div>
            {href && (
              <a
                href={href}
                target="_blank"
                rel="noreferrer noopener"
                aria-label={`${copy.open} ${source.name}`}
              >
                <ArrowUpRight size={18} />
              </a>
            )}
          </article>
        );
      })
    }
  </section>
</BaseLayout>
