---
import { getSiteConfig } from "../lib/config";
import { getUi, localizeSite, localizedPath, type Locale } from "../lib/i18n";
import { isExternalUrl } from "../lib/urls";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = getUi(locale).footer;
const site = localizeSite(getSiteConfig(), locale);
const resolveHref = (href: string) => (isExternalUrl(href) ? href : localizedPath(locale, href));
---

<footer class="site-footer">
  <div class="page-shell footer-inner">
    <div>
      <strong>{site.name} for {site.productName}</strong>
      <span>{site.description}</span>
    </div>
    <nav aria-label={copy.navigation}>
      <a href={site.repositoryUrl} target="_blank" rel="noreferrer noopener">GitHub</a>
      <a href={resolveHref(site.links.rss)}>RSS</a>
      <a href={resolveHref(site.links.jsonFeed)}>JSON Feed</a>
      <a href={localizedPath(locale, "/downloads/")}>{copy.download}</a>
      <a href={resolveHref(site.links.license)} target="_blank" rel="noreferrer noopener">License</a>
    </nav>
  </div>
</footer>
